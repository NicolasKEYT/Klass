{
  "name": "klass",
  "private": true,
  "description": "ERP educacional open source para automação da jornada acadêmica.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @klass/web dev",
    "dev:workers": "pnpm --filter @klass/workers dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
