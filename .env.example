# Copie para .env e preencha com os valores do seu projeto. Nunca
# versione o .env de verdade — só este exemplo.

# --- Frontend (apps/web) ---
# Prefixo VITE_ = variável pública, embutida no bundle do navegador.
# Nunca coloque a secret/service role key aqui — só a publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_WORKERS_URL=http://localhost:8787

# --- Workers (apps/workers) ---
# Estas NÃO vão para um .env consumido em runtime pelo Worker publicado —
# use `wrangler secret put <NOME>` em produção. Para desenvolvimento
# local, copie estas linhas para apps/workers/.dev.vars (também ignorado
# pelo git). Ver README para o passo a passo completo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
# Qualquer string aleatória longa — o mesmo valor deve ficar no Supabase
# Vault, com o nome `webhook_secret`; a URL base do Worker também fica no Vault,
# com o nome `webhook_url` (ver README, "Webhooks do banco").
WEBHOOK_SECRET=
# Opcional: remetente dos e-mails, com domínio verificado no Resend.
# Vazio = "Klass <onboarding@resend.dev>" (só entrega para o dono da conta).
EMAIL_REMETENTE="Klass <no-reply@seu-dominio.com.br>"
